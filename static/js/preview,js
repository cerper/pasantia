document.addEventListener('DOMContentLoaded', () => {
    // Escuchar el cambio en todos los inputs de imagen con la clase 'image-input'
    document.querySelectorAll('.image-input').forEach(input => {
        input.addEventListener('change', function (e) {
            const file = e.target.files[0];
            const label = this.closest('label');
            const placeholder = label.querySelector('.upload-placeholder');
            const preview = label.querySelector('.image-preview');

            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.style.backgroundImage = `url('${e.target.result}')`;
                    placeholder.classList.add('hidden');
                    preview.classList.remove('hidden');
                };

                reader.readAsDataURL(file);
            }
        });
    });

    // Delegación de eventos para el botón de eliminar imagen
    document.body.addEventListener('click', (e) => {
        const removeBtn = e.target.closest('.remove-btn');
        if (removeBtn) {
            e.preventDefault();
            e.stopPropagation();

            const label = removeBtn.closest('label');
            const input = label.querySelector('.image-input');
            const placeholder = label.querySelector('.upload-placeholder');
            const preview = label.querySelector('.image-preview');

            input.value = '';
            preview.style.backgroundImage = '';
            preview.classList.add('hidden');
            placeholder.classList.remove('hidden');
        }
    });
});